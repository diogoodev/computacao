properties:
  file.name:
    displayName: Materia
  note.professor:
    displayName: Professor
  note.ch:
    displayName: CH
  note.duracao:
    displayName: Duracão
  note.exame_final:
    displayName: Exame Final
views:
  - type: table
    name: Tabela
    filters:
      and:
        - "!professor.isEmpty()"
    order:
      - file.name
      - professor
      - ch
      - inicio
      - fim
    sort:
      - property: duracao
        direction: ASC
      - property: ch
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.professor: 189
  - type: table
    name: Visualizaçao padrão
    order:
      - file.name
      - professor
